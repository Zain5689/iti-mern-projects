      "text": "\nA Progressive Web App (PWA) is a website that uses modern APIs to\nprovide an app-like experience. It must be Fast, Reliable (works offline),\nand Installable.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nA Progressive Web App (PWA) is a website that uses modern APIs to provide an app-like experience. It must be Fast, Reliable (works offline), and Installable.",
      "autoResize": false,
      "lineHeight": 1.25
    },
