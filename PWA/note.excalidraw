      "isDeleted": false,
      "boundElements": [],
      "updated": 1778763839912,
      "link": null,
      "locked": false,
      "text": "Workbox: A Google library that simplifies Service Worker logic, making it\neasier to manage caching strategies (e.g., Cache-first vs. Network-\nfirst).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workbox: A Google library that simplifies Service Worker logic, making it easier to manage caching strategies (e.g., Cache-first vs. Network-first).",
      "autoResize": false,
      "lineHeight": 1.25
    },
