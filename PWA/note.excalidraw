      "updated": 1778763839912,
      "link": null,
      "locked": false,
      "text": "Cache Storage API: Used to store static assets (HTML, CSS, JS,\nImages) so they load instantly without a network.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache Storage API: Used to store static assets (HTML, CSS, JS, Images) so they load instantly without a network.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
