      "text": "\nWeb App Manifest: A JSON file that defines your app’s identity (Name,\nIcons, Theme colors). It allows the browser to \"install\" your site on\nthe home screen.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nWeb App Manifest: A JSON file that defines your app’s identity (Name, Icons, Theme colors). It allows the browser to \"install\" your site on the home screen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
