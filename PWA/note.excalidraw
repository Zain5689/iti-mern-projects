      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Performance: Using \"Core Web Vitals\" to ensure the app feels smooth and reaches high performance scores.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "E-re1lGZZ20-MKsxwhLh7",
