  "item": [
    {
      "name": "Bookmarks",
      "item": [
        {
          "name": "Create Bookmark",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.example.com\",\n  \"title\": \"Example Website\",\n  \"description\": \"This is an example bookmark\",\n  \"tags\": [\"example\", \"website\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["bookmarks"]
            },
            "description": "Create a new bookmark with required url and title fields"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has id field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "});",
                  "",
                  "pm.test('Response has correct title', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('Example Website');",
                  "});",
                  "",
                  "// Store the bookmark id for later use",
                  "pm.environment.set('bookmark_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Bookmarks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["bookmarks"]
            },
            "description": "Retrieve all bookmarks"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "});",
                  "",
                  "pm.test('Bookmarks have required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('id');",
                  "        pm.expect(jsonData[0]).to.have.property('title');",
                  "        pm.expect(jsonData[0]).to.have.property('url');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Bookmark by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookmarks/{{bookmark_id}}",
              "host": ["{{base_url}}"],
              "path": ["bookmarks", "{{bookmark_id}}"]
            },
            "description": "Retrieve a specific bookmark by its ID"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has bookmark data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('url');",
                  "});",
                  "",
                  "pm.test('Returned bookmark ID matches request', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get('bookmark_id'));",
                  "});"
                ]
              }
            }
          ]
        },
