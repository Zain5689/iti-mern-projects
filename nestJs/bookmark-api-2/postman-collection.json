                  "pm.test('Bookmark description was updated', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.description).to.eql('Updated description for the bookmark');",
                  "});"
                ]
              }
            }
          ]
        },
